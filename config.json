{
  "name": "にゃんぷい",
  "profile": "なんぷいの説明",
  "version": "0.0.1",
  "Port": 8009,
  "certPath": "",
  "keyPath": "",
  "javascript_include": [
    "./javascript/base.js",
    "./javascript/lib/nyanPlate.js",
    "./javascript/lib/nyanPlateToJson.js"
  ],
  "log": {
    "Filename": "./logs/nyanpui.log",
    "MaxSize": 5,
    "MaxBackups": 3,
    "MaxAge": 7,
    "Compress": true,
    "EnableLogging": false,
    "Level": "info"
  },
  "httpTimeouts": {
    "readHeaderTimeout": "30s",
    "readTimeout": "20m",
    "writeTimeout": "30m",
    "idleTimeout": "5m"
  },
  "receiveLimits": {
    "httpBodyBytes": "20MB",
    "webSocketMessageBytes": "20MB"
  },
  "APIHotReload": {
    "Enabled": true,
    "Interval": "1s"
  }
}
